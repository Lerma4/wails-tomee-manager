<?xml version="1.0" encoding="UTF-8"?>
<!-- Connector shapes copied from a real apache-tomee-plus-1.7.3 server.xml:
     the protocol attribute holds a class name, not the literal "HTTP/1.1". -->
<Server port="8005" shutdown="SHUTDOWN">
  <Service name="Catalina">
    <Connector port="8080" connectionTimeout="20000" protocol="org.apache.coyote.http11.Http11NioProtocol" redirectPort="8443" xpoweredBy="false" server="Apache TomEE"/>
    <!--
    <Connector executor="tomcatThreadPool" port="8081" protocol="HTTP/1.1" connectionTimeout="20000" redirectPort="8443" />
    -->
    <Connector port="8443" protocol="org.apache.coyote.http11.Http11Protocol" maxThreads="150" SSLEnabled="true" scheme="https" secure="true" clientAuth="false" sslProtocol="TLS" xpoweredBy="false" server="Apache TomEE" keystorefile="${user.home}/.keystore" keystorePass="changeit"/>
    <Connector port="8009" protocol="AJP/1.3" redirectPort="8443"/>
    <Engine name="Catalina" defaultHost="localhost">
      <Host name="localhost" appBase="webapps" unpackWARs="true" autoDeploy="true"/>
    </Engine>
  </Service>
</Server>
